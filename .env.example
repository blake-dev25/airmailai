# for scripts/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# build flags (read by wxt.config.ts and airmailai_web's vite.config.ts;
# the store zip and web deploy force the safe values)
# AIRMAILAI_LOG_LEVEL: console logging for both the extension and the website.
#   'errors' (default) = errors + warnings, 'info' adds operational logs,
#   'all' adds full API request payloads. Use 'all' for local dev/debugging.
# WXT_ALLOW_LOCALHOST: 'true' includes http://localhost in the manifest (off by default; set 'true' for local dev)
AIRMAILAI_LOG_LEVEL=
WXT_ALLOW_LOCALHOST=