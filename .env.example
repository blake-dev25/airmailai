# for scripts/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# extension build flags (read by wxt.config.ts; the store zip forces both off)
# WXT_DEBUG_API_LOGGING: 'true' logs API request payloads to the SW console
# WXT_ALLOW_LOCALHOST: 'false' excludes http://localhost from the manifest (on by default for local dev)
WXT_DEBUG_API_LOGGING=
WXT_ALLOW_LOCALHOST=