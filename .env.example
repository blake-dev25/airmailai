# *** for scripts/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# *** website deploy (scripts/deploy-web.ts) and AWS mode for the model list
# scripts. When AIRMAILAI_WEB_AWS_PROFILE is set, scripts/update-model-list.ts
# and scripts/model-watcher.ts keep their caches/state in the state bucket and
# publish models.json to the website bucket; leave it unset (or pass --local)
# for a fully offline run against packages/airmailai_web/static/models.json.
AIRMAILAI_WEB_AWS_PROFILE=
AIRMAILAI_WEB_S3_BUCKET=
AIRMAILAI_WEB_CLOUDFRONT_DISTRIBUTION_ID=
AIRMAILAI_MODEL_LIST_STATE_BUCKET=
# Optional: the model list scripts post their reports here when set. Required
# by scripts/deploy-model-list.ts, which copies it into SSM for the Lambdas.
AIRMAILAI_DISCORD_WEBHOOK_URL=

# *** build flags (read by wxt.config.ts and airmailai_web's vite.config.ts;
# the store zip and web deploy force the safe values)
# AIRMAILAI_LOG_LEVEL: console logging for both the extension and the website.
#   'errors' (default) = errors + warnings, 'info' adds operational logs,
#   'all' adds full API request payloads. Use 'all' for local dev/debugging.
# WXT_ALLOW_LOCALHOST: 'true' includes http://localhost in the manifest (off by default; set 'true' for local dev)
AIRMAILAI_LOG_LEVEL=
WXT_ALLOW_LOCALHOST=
