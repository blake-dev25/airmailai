{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node", "bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "moduleDetection": "force"
    },
    "include": ["*.ts"]
}
