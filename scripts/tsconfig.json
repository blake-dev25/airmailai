{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@courierai/shared": ["../packages/shared/src/index.ts"]
        },
        "types": ["node", "bun"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "moduleDetection": "force"
    },
    "include": ["**/*.ts", "../packages/courierai_ext/globals.d.ts"]
}
